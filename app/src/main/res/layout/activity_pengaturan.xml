<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warna_latar"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/judul_pengaturan"
            android:textColor="@color/warna_teks_utama"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sub_pengaturan"
            android:textColor="@color/warna_teks_sekunder"
            android:textSize="13sp" />

        <!-- ===== PROFIL ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_kartu"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grup_profil"
                android:textColor="@color/warna_teks_utama"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_nama"
                android:inputType="textPersonName"
                android:textColor="@color/warna_teks_utama"
                android:textColorHint="@color/warna_teks_sekunder" />
        </LinearLayout>

        <!-- ===== A. BAHASA ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_kartu"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grup_bahasa"
                android:textColor="@color/warna_teks_utama"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgBahasa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbIndonesia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/radio_bahasa_id"
                    android:textColor="@color/warna_teks_utama" />

                <RadioButton
                    android:id="@+id/rbEnglish"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/radio_bahasa_en"
                    android:textColor="@color/warna_teks_utama" />
            </RadioGroup>
        </LinearLayout>

        <!-- ===== B. MODE TAMPILAN ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_kartu"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grup_tema"
                android:textColor="@color/warna_teks_utama"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgTema"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbTerang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/radio_terang"
                    android:textColor="@color/warna_teks_utama" />

                <RadioButton
                    android:id="@+id/rbGelap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/radio_gelap"
                    android:textColor="@color/warna_teks_utama" />

                <RadioButton
                    android:id="@+id/rbSistem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/radio_sistem"
                    android:textColor="@color/warna_teks_utama" />
            </RadioGroup>
        </LinearLayout>

        <!-- ===== C. UKURAN TEKS ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_kartu"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grup_ukuran"
                android:textColor="@color/warna_teks_utama"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgUkuran"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbKecil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ukuran_kecil"
                    android:textColor="@color/warna_teks_utama" />

                <RadioButton
                    android:id="@+id/rbSedang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ukuran_sedang"
                    android:textColor="@color/warna_teks_utama" />

                <RadioButton
                    android:id="@+id/rbBesar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ukuran_besar"
                    android:textColor="@color/warna_teks_utama" />
            </RadioGroup>
        </LinearLayout>

        <!-- ===== D. WARNA AKSEN ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_kartu"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grup_aksen"
                android:textColor="@color/warna_teks_utama"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgAksen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbHijau"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/aksen_hijau"
                    android:textColor="@color/warna_teks_utama" />

                <RadioButton
                    android:id="@+id/rbBiru"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/aksen_biru"
                    android:textColor="@color/warna_teks_utama" />

                <RadioButton
                    android:id="@+id/rbOranye"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/aksen_oranye"
                    android:textColor="@color/warna_teks_utama" />
            </RadioGroup>
        </LinearLayout>

        <!-- ===== E. NOTIFIKASI ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_kartu"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grup_notifikasi"
                android:textColor="@color/warna_teks_utama"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swNotifikasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/desc_notifikasi"
                android:textColor="@color/warna_teks_sekunder"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ===== F. RINGKASAN & RESET ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_kotak_ringkasan"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_ringkasan"
                android:textColor="@color/warna_teks_sekunder"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRingkasan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/warna_teks_utama"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvStatusNotifikasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/warna_teks_sekunder"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnReset"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="@string/btn_reset"
            android:textAllCaps="false"
            android:textColor="@color/warna_tombol_reset"
            app:cornerRadius="12dp"
            app:strokeColor="@color/warna_tombol_reset" />
    </LinearLayout>
</ScrollView>